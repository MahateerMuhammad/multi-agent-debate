# Application Environment Configuration
PROJECT_NAME="Multi-Agent Debate"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
LOG_FORMAT="console"  # Options: console, json
API_V1_STR="/api/v1"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Open-Source LLM Configuration (Qwen 2.5)
# LLM_PROVIDER Options: "qwen", "ollama", "vllm", "openrouter", "mock"
LLM_PROVIDER="qwen"
LLM_MODEL="qwen2.5-72b-instruct"

# Endpoint URL Examples:
# Hosted Alibaba Cloud DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# Local Ollama: http://localhost:11434/v1
# Local vLLM / SGLang: http://localhost:8000/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_API_KEY="your_qwen_api_key_here"

LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7

# Data & Storage Directories
VECTORSTORE_DIR="./data/vectorstore"
PROCESSED_DATA_DIR="./data/processed"
RAW_DATA_DIR="./data/raw"
